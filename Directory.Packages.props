<Project>

  <ItemGroup>
    <!-- Roslyn: keep at or below the compiler in the pinned SDK, or consumers cannot load the generator. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />

    <!-- Testing -->
    <PackageVersion Include="CsCheck" Version="5.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />

    <!-- Benchmarks and competitor baselines -->
    <!-- 0.15.x does not recognise .NET 11; move to a stable 0.16 when it ships. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="Parlot" Version="2.0.0" />
    <PackageVersion Include="Pidgin" Version="3.5.1" />
    <PackageVersion Include="Sprache" Version="2.3.1" />
    <PackageVersion Include="Superpower" Version="3.2.1" />
  </ItemGroup>

</Project>
